# 로컬 실행용 환경변수 예시. 이 파일을 .dev.vars 로 복사해서 값을 채우세요. (.dev.vars 는 git 에 올라가지 않습니다)
# Google OAuth 클라이언트 ID (비밀값 아님). 클라이언트 '비밀번호(secret)'는 이 서비스에 필요 없습니다.
GOOGLE_CLIENT_ID=
# 세션 쿠키 서명용 임의 문자열(32자 이상). 아무에게도 알려주지 마세요.
SESSION_SECRET=
# (선택) 허용할 이메일 / 도메인, 쉼표로 구분. 둘 다 비우면 인증된 모든 Google 계정 허용
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# 로컬에서 로그인 없이 화면만 보려면 1 (localhost 접속일 때만 동작)
DEV_AUTH_BYPASS=1
